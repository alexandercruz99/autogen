# Optional environment overrides. Prefer config.yaml for most settings.
# Store the private key on disk and point KALSHI_PRIVATE_KEY_PATH at it.
# Do not paste private keys into chat or commit them.

KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_ENVIRONMENT=production
KALSHI_MODE=paper
KALSHI_CONFIG=config.yaml
